#!/bin/bash

# Скрипт сразу остановится при любой ошибке
set -e

# ==============================================================================
# НАСТРОЙКИ ПРОЕКТА
# ==============================================================================
MAIN_CLASS="Main"                # Главный класс (без пакета, так как он в корне java)
SRC_DIR="src/main/java"          # Папка с исходным кодом из вашего скриншота
BUILD_DIR="build_manual"         # Папка для результатов ручной сборки

# Внутренние папки для сборки
OUT_DIR="$BUILD_DIR/classes"     # Сюда складываем скомпилированный код (.class)
DOC_DIR="$BUILD_DIR/docs"        # Сюда генерируем документацию
JAR_NAME="$BUILD_DIR/app.jar"    # Имя готового JAR-файла
MANIFEST="$BUILD_DIR/MANIFEST.MF"# Файл манифеста

echo "=== [1/6] Очистка и создание папок ==="
rm -rf "$BUILD_DIR"
mkdir -p "$OUT_DIR"
mkdir -p "$DOC_DIR"

echo "=== [2/6] Поиск Java-файлов ==="
SOURCES_LIST="$BUILD_DIR/sources.txt"
find "$SRC_DIR" -maxdepth 1 -name "*.java" > "$SOURCES_LIST"
echo "Найдено файлов для компиляции: $(wc -l < "$SOURCES_LIST")"

echo "=== [3/6] Компиляция (javac) ==="
# Компилируем все найденные файлы и складываем их в папку classes
javac -d "$OUT_DIR" @"$SOURCES_LIST"
echo "Компиляция успешно завершена."

echo "=== [4/6] Генерация документации (javadoc) ==="
# Генерируем документацию для файлов из папки src/main/java
javadoc -d "$DOC_DIR" -sourcepath "$SRC_DIR" *.java -quiet 2>/dev/null || javadoc -d "$DOC_DIR" -sourcepath "$SRC_DIR" @"$SOURCES_LIST" -quiet
echo "Документация создана в: $DOC_DIR"

echo "=== [5/6] Создание JAR-архива ==="
# Создаем манифест. Так как пакета нет, пишем просто Main-Class: Main
echo "Manifest-Version: 1.0" > "$MANIFEST"
echo "Main-Class: $MAIN_CLASS" >> "$MANIFEST"
echo "" >> "$MANIFEST" # Пустая строка в конце обязательна!

# Упаковываем содержимое папки classes в JAR
jar cmf "$MANIFEST" "$JAR_NAME" -C "$OUT_DIR" .
echo "Создан архив: $JAR_NAME"

echo "=== [6/6] Запуск приложения ==="
echo "--------------------------------------------------"
java -jar "$JAR_NAME"
echo "--------------------------------------------------"
echo "Программа успешно завершила работу."
